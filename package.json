{
  "name": "kb923l-mac",
  "version": "1.0.0",
  "description": "KB923L Pro klavye yapılandırıcısı (macOS)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "helper": "swiftc -O -o build/kbmacro helper/kbmacro.swift",
    "dist": "npm run helper && vite build && electron-builder --mac dir && sh tools/sign.sh"
  },
  "type": "module",
  "dependencies": {
    "node-hid": "^3.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.8"
  },
  "productName": "KB923L Pro",
  "private": true,
  "build": {
    "appId": "com.kb923l.mac",
    "productName": "KB923L Pro",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/kbmacro",
        "to": "kbmacro"
      }
    ],
    "asarUnpack": [
      "node_modules/node-hid/**"
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "extendInfo": {
        "NSInputMonitoringUsageDescription": "Klavyeye aydınlatma ve ekran ayarlarını göndermek ve makro tuşlarını algılamak için gerekir."
      },
      "identity": null,
      "hardenedRuntime": false
    },
    "directories": {
      "output": "release"
    },
    "npmRebuild": false
  },
  "author": "KB923L Mac"
}